Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Type}"
{
	%Group Type
	{
		%Group Include
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Type/^*"
		}
		%File "Source/^*"
		%Group Documentation
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Type true
	{
		&
		{
			MalterlibLibrary_Type ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Type;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Type true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Type true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Type true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Type;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Type "@('Test/*'->MakeAbsolute())"
}

