Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Type}"
{
	%Group "Type"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Type/^*"
		}
		%File "Source/^*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Type define bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Type"
	{
		!!MalterlibLibrary_Type true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Type define bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Type true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Type"
	MalterlibTestFiles_Malterlib_Type define [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

